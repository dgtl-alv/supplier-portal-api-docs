{
  "openapi": "3.1.0",
  "info": {
    "title": "Supplier Portal Integration API",
    "version": "2.3.1",
    "description": "JSON bridge APIs for QAD master data, ailox product-supplier mappings, and approved NSR suppliers. Upstream credentials remain private behind n8n."
  },
  "servers": [
    {
      "url": "https://hfkjs.alvaauto.com/webhook",
      "description": "n8n staging"
    }
  ],
  "security": [
    {
      "HeaderAuth": []
    }
  ],
  "tags": [
    {
      "name": "QAD",
      "description": "QAD master data through private jump host"
    },
    {
      "name": "Suppliers",
      "description": "Approved supplier data from NSR"
    },
    {
      "name": "ailox",
      "description": "Read-only product and supplier mappings from ailox"
    }
  ],
  "paths": {
    "/supplier-portal/staging/product-master": {
      "post": {
        "tags": [
          "QAD"
        ],
        "operationId": "getProductMaster",
        "summary": "List QAD product master",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false
              },
              "example": {}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized QAD response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QadProductResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/supplier-portal/staging/bom-master": {
      "post": {
        "tags": [
          "QAD"
        ],
        "operationId": "getBomMaster",
        "summary": "Get QAD BOM by product code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "productcode"
                ],
                "properties": {
                  "productcode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              },
              "example": {
                "productcode": "PRODUCT_CODE"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized QAD response; inspect success for business rejection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QadBomResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/supplier-portal/staging/list-supplier": {
      "post": {
        "tags": [
          "Suppliers"
        ],
        "operationId": "listSuppliers",
        "summary": "List approved suppliers",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "Case-insensitive company-name search"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 50
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  }
                }
              },
              "example": {
                "q": "Contoh",
                "limit": 50,
                "offset": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paginated approved suppliers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplierListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UpstreamUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "description": "NSR rate limit exceeded"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/supplier-portal/staging/detail-supplier": {
      "get": {
        "tags": [
          "Suppliers"
        ],
        "operationId": "getSupplier",
        "summary": "Get approved supplier detail",
        "parameters": [
          {
            "name": "public_id",
            "in": "query",
            "required": true,
            "description": "Opaque 16-character lowercase hexadecimal supplier ID",
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            "example": "a100000000000001"
          }
        ],
        "responses": {
          "200": {
            "description": "Approved supplier and document checklist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SupplierDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid public_id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UpstreamUnauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Supplier unknown, not approved, or voided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "NSR rate limit exceeded"
          },
          "500": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/supplier-portal/staging/qad-supplier-list": {
      "post": {
        "tags": [
          "QAD"
        ],
        "operationId": "listQadSuppliers",
        "summary": "List QAD suppliers",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "q": {
                    "type": "string",
                    "description": "Case-insensitive substring search across supplier code, names, emails, address, city, postal code, type, and active status."
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200,
                    "default": 50
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  }
                }
              },
              "example": {
                "q": "astra",
                "limit": 50,
                "offset": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Normalized QAD supplier response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QadSupplierResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        },
        "description": "Fetches the QAD supplier list, then applies case-insensitive search and pagination in n8n."
      }
    },
    "/supplier-portal/staging/list-product": {
      "post": {
        "tags": [
          "ailox"
        ],
        "operationId": "listProducts",
        "summary": "List ailox product-supplier mappings",
        "description": "Reads distinct product-supplier mappings from ailox, including model names resolved from PFEP product-class mappings. Search is case-insensitive. Supplier names containing vmoto are excluded.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductListRequest"
              },
              "example": {
                "q": "bolt",
                "supplier_name": "astra",
                "limit": 50,
                "offset": 0,
                "model": "P2.0"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Paginated product-supplier mappings",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductListResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HeaderAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Native n8n Header Auth credential for Supplier Portal clients."
      }
    },
    "responses": {
      "Forbidden": {
        "description": "Missing or invalid n8n Header Auth",
        "content": {
          "text/plain": {
            "schema": {
              "type": "string"
            },
            "example": "Authorization data is wrong!"
          }
        }
      },
      "UpstreamUnauthorized": {
        "description": "NSR credential missing, invalid, or revoked",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "description": "Request or upstream error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "QadMeta": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "const": "QAD_WSA"
          },
          "environment": {
            "type": "string",
            "const": "staging"
          },
          "operation": {
            "type": "string"
          },
          "statusCode": {
            "type": "integer"
          },
          "contentType": {
            "type": "string"
          }
        }
      },
      "QadError": {
        "type": "object",
        "required": [
          "success",
          "error",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "QAD_REJECTED",
                  "QAD_SOAP_FAULT",
                  "QAD_HTTP_ERROR",
                  "QAD_INVALID_RESPONSE"
                ]
              },
              "message": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            }
          },
          "meta": {
            "$ref": "#/components/schemas/QadMeta"
          }
        }
      },
      "QadProductResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "success",
              "data",
              "meta"
            ],
            "properties": {
              "success": {
                "type": "boolean",
                "const": true
              },
              "data": {
                "type": "object",
                "required": [
                  "products",
                  "total"
                ],
                "properties": {
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "total": {
                    "type": "integer"
                  }
                }
              },
              "meta": {
                "$ref": "#/components/schemas/QadMeta"
              }
            }
          },
          {
            "$ref": "#/components/schemas/QadError"
          }
        ]
      },
      "QadBomResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "success",
              "data",
              "meta"
            ],
            "properties": {
              "success": {
                "type": "boolean",
                "const": true
              },
              "data": {
                "type": "object",
                "required": [
                  "components",
                  "total"
                ],
                "properties": {
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  },
                  "total": {
                    "type": "integer"
                  }
                }
              },
              "meta": {
                "$ref": "#/components/schemas/QadMeta"
              }
            }
          },
          {
            "$ref": "#/components/schemas/QadError"
          }
        ]
      },
      "SupplierListItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "public_id",
          "company_name",
          "contact_name",
          "contact_email",
          "contact_phone",
          "status",
          "created_at",
          "approved_at"
        ],
        "properties": {
          "public_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "company_name": {
            "type": "string"
          },
          "contact_name": {
            "type": "string"
          },
          "contact_email": {
            "type": "string",
            "format": "email"
          },
          "contact_phone": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "approved"
          },
          "created_at": {
            "type": "string"
          },
          "approved_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "SupplierListResponse": {
        "type": "object",
        "required": [
          "data",
          "total",
          "limit",
          "offset"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupplierListItem"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "DocumentSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_type_name",
          "status"
        ],
        "properties": {
          "document_type_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_submitted",
              "submitted",
              "pending",
              "checked_ok",
              "checked_reject"
            ]
          }
        }
      },
      "SupplierDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SupplierListItem"
          },
          {
            "type": "object",
            "required": [
              "rejected_at",
              "documents"
            ],
            "properties": {
              "rejected_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "documents": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/DocumentSummary"
                }
              }
            }
          }
        ]
      },
      "QadSupplierItem": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "t_active": {
            "type": "string"
          },
          "t_address": {
            "type": "string"
          },
          "t_city": {
            "type": "string"
          },
          "t_code": {
            "type": "string"
          },
          "t_email1": {
            "type": "string"
          },
          "t_email2": {
            "type": "string"
          },
          "t_full_name": {
            "type": "string"
          },
          "t_postal_code": {
            "type": "string"
          },
          "t_sort_name": {
            "type": "string"
          },
          "t_type": {
            "type": "string"
          },
          "t_update_date": {
            "type": "string"
          }
        }
      },
      "QadSupplierResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "success",
              "data",
              "meta"
            ],
            "properties": {
              "success": {
                "type": "boolean",
                "const": true
              },
              "data": {
                "type": "object",
                "required": [
                  "suppliers",
                  "total",
                  "sourceTotal",
                  "q",
                  "limit",
                  "offset"
                ],
                "properties": {
                  "suppliers": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/QadSupplierItem"
                    }
                  },
                  "total": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sourceTotal": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Total supplier rows returned by QAD before filtering."
                  },
                  "q": {
                    "type": "string"
                  },
                  "limit": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 200
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "meta": {
                "$ref": "#/components/schemas/QadMeta"
              }
            }
          },
          {
            "$ref": "#/components/schemas/QadError"
          }
        ]
      },
      "ProductListRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "q": {
            "type": "string",
            "maxLength": 100,
            "description": "Case-insensitive substring search across item number, item name, supplier code, and supplier name."
          },
          "item_number": {
            "type": "string",
            "maxLength": 100
          },
          "item_name": {
            "type": "string",
            "maxLength": 200
          },
          "supplier_code": {
            "type": "string",
            "maxLength": 100
          },
          "supplier_name": {
            "type": "string",
            "maxLength": 200
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200,
            "default": 50
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "model": {
            "type": "string",
            "maxLength": 100,
            "description": "Case-insensitive substring filter for comma-separated product model names."
          }
        }
      },
      "ProductListItem": {
        "type": "object",
        "required": [
          "item_number",
          "item_name",
          "model",
          "supplier_name",
          "supplier_code"
        ],
        "properties": {
          "item_number": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "supplier_code": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "Comma-separated product model names in source order; empty when no model mapping exists."
          }
        }
      },
      "ProductListMeta": {
        "type": "object",
        "required": [
          "source",
          "operation",
          "total",
          "count",
          "limit",
          "offset",
          "filters"
        ],
        "properties": {
          "source": {
            "type": "string",
            "const": "ailox"
          },
          "operation": {
            "type": "string",
            "const": "listProducts"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "count": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "filters": {
            "type": "object",
            "required": [
              "q",
              "item_number",
              "item_name",
              "model",
              "supplier_code",
              "supplier_name"
            ],
            "properties": {
              "q": {
                "type": "string"
              },
              "item_number": {
                "type": "string"
              },
              "item_name": {
                "type": "string"
              },
              "supplier_code": {
                "type": "string"
              },
              "supplier_name": {
                "type": "string"
              },
              "model": {
                "type": "string"
              }
            }
          }
        }
      },
      "ProductListResponse": {
        "type": "object",
        "required": [
          "success",
          "data",
          "meta"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductListItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/ProductListMeta"
          }
        }
      }
    }
  }
}
